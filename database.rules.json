{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'displayName', 'createdAt'])"
      }
    },

    "userGroups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$groupId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('groups/' + $groupId + '/adminUid').val() === auth.uid) && (newData.exists() == false || root.child('groups/' + $groupId + '/members/' + $uid).exists())"
        }
      }
    },

    "userStats": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['weeklyTotals', 'weeklySessionCounts', 'dailyTotals'])"
      }
    },

    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === newData.val() || (newData.exists() == false && root.child('groups/' + data.val() + '/adminUid').val() === auth.uid))"
      }
    },

    "activeSessions": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "completedSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "groups": {
      "$groupId": {
        ".read": "auth != null && root.child('groups/' + $groupId + '/members/' + auth.uid).exists()",
        ".write": "auth != null && root.child('groups/' + $groupId + '/adminUid').val() === auth.uid && newData.exists() == false",

        "name": {
          ".write": "auth != null && (!data.exists() ? true : root.child('groups/' + $groupId + '/adminUid').val() === auth.uid)"
        },
        "inviteCode": {
          ".write": "auth != null && !data.exists()"
        },
        "createdBy": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists()"
        },
        "adminUid": {
          ".write": "auth != null && (!data.exists() ? newData.val() === auth.uid : data.val() === auth.uid && (newData.exists() == false || root.child('groups/' + $groupId + '/members/' + newData.val()).exists()))"
        },

        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('groups/' + $groupId + '/adminUid').val() === auth.uid)"
          }
        },

        "live": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('groups/' + $groupId + '/adminUid').val() === auth.uid) && (newData.exists() == false || root.child('groups/' + $groupId + '/members/' + $uid).exists())"
          }
        },

        "weeklyTotals": {
          "$weekId": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('groups/' + $groupId + '/members/' + $uid).exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },

        "weeklySessionCounts": {
          "$weekId": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('groups/' + $groupId + '/members/' + $uid).exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },

        "dailyTotals": {
          "$dayId": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('groups/' + $groupId + '/members/' + $uid).exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },

        "messages": {
          "$messageId": {
            ".write": "auth != null && root.child('groups/' + $groupId + '/members/' + auth.uid).exists() && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'displayName', 'text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500"
          }
        }
      }
    }
  }
}
