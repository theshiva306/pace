{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "userGroups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$groupId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('groups/' + $groupId + '/adminUid').val() === auth.uid)",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },

    "userStats": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('userGroups/' + auth.uid).hasChildren())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChild('updatedAt')"
      }
    },

    "activeSessions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('userGroups/' + auth.uid).hasChildren())",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChild('sessionId') && newData.child('startedAt').isNumber() && (newData.child('status').val() === 'active' || newData.child('status').val() === 'paused' || newData.child('status').val() === 'onBreak' || newData.child('status').val() === 'stopped'))"
      }
    },

    "completedSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "groups": {
      "$groupId": {
        ".write": "auth != null && ((data.exists() && data.child('adminUid').val() === auth.uid && !newData.exists()) || (data.exists() && !data.child('members/' + auth.uid).exists() && newData.child('members/' + auth.uid).exists() && newData.child('adminUid').val() === data.child('adminUid').val() && newData.child('createdBy').val() === data.child('createdBy').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('name').val() === data.child('name').val()) || (!data.exists() && newData.child('adminUid').val() === auth.uid && newData.child('createdBy').val() === auth.uid && newData.child('members/' + auth.uid).exists()))",

        "name": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('groups/' + $groupId + '/adminUid').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
        },

        "createdBy": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },

        "createdAt": {
          ".write": "auth != null && !data.exists()"
        },

        "adminUid": {
          ".read": "auth != null && root.child('groups/' + $groupId + '/members/' + auth.uid).exists()",
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid))"
        },

        "members": {
          ".read": "auth != null && root.child('groups/' + $groupId + '/members/' + auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('groups/' + $groupId + '/adminUid').val() === auth.uid)",
            ".validate": "!newData.exists() || newData.hasChildren(['displayName', 'joinedAt'])"
          }
        },

        "messages": {
          ".read": "auth != null && root.child('groups/' + $groupId + '/members/' + auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && root.child('groups/' + $groupId + '/members/' + auth.uid).exists() && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && data.child('timestamp').val() <= now - 604800000))",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'displayName', 'text', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && newData.child('uid').val() === auth.uid)"
          }
        }
      }
    }
  }
}
